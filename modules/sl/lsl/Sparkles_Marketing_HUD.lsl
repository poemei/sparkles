// Sparkles Marketing HUD v1.4.2 — native Second Life interface (staged).
// No Corrade, PHP, HTTP, endpoint or authentication-token notecard.
// Reads venues.cfg and approved_groups.cfg. Post is explicitly disabled
// until authenticated native SL object-origin messaging is implemented.
// Does not claim to publish notices or attach inventory landmarks.
string VERSION = "1.4.2";
string VENUES_CARD = "venues.cfg";
string GROUPS_CARD = "approved_groups.cfg";
string SIGNATURE = "~~ This message generated by Sparkles Entertainment ~~";
string title = "";
string message = "";
string venue = "";
string slurl = "";
string landmark = "";
string active_set = "events";
list aliases = [];
list venue_names = [];
list venue_urls = [];
list venue_landmarks = [];
list group_sets = [];
list group_names = [];
list group_delays = [];
key venues_query = NULL_KEY;
key groups_query = NULL_KEY;
integer venues_line = 0;
integer groups_line = 0;
integer venues_ready = FALSE;
integer groups_ready = FALSE;
integer menu_channel = 0;
integer menu_handle = 0;
integer input_channel = 0;
integer input_handle = 0;
integer input_mode = 0;
integer INPUT_TITLE = 1;
integer INPUT_MESSAGE = 2;
integer INPUT_ALIAS = 3;
integer INPUT_VENUE = 4;
integer INPUT_SLURL = 5;
integer INPUT_SET = 6;

say(string value) { llOwnerSay(value); }
string trim(string value) { return llStringTrim(value, STRING_TRIM); }
closeMenu()
{
    if (menu_handle) llListenRemove(menu_handle);
    menu_handle = 0;
}
closeInput()
{
    if (input_handle) llListenRemove(input_handle);
    input_handle = 0;
}
string hereURL()
{
    vector p = llGetPos();
    return "https://maps.secondlife.com/secondlife/"
        + llEscapeURL(llGetRegionName()) + "/"
        + (string)((integer)p.x) + "/"
        + (string)((integer)p.y) + "/"
        + (string)((integer)p.z);
}
string noticeBody()
{
    return message + "\n\nYour Ride Awaits -> " + slurl
        + "\n\n" + SIGNATURE;
}
loadVenues()
{
    aliases = []; venue_names = []; venue_urls = []; venue_landmarks = [];
    venues_line = 0;
    venues_ready = FALSE;
    venues_query = NULL_KEY;
    if (llGetInventoryType(VENUES_CARD) != INVENTORY_NOTECARD)
    {
        say("venues.cfg missing. Manual venue and Use Here remain available.");
        venues_ready = TRUE;
        return;
    }
    venues_query = llGetNotecardLine(VENUES_CARD,venues_line);
}
loadGroups()
{
    group_sets = []; group_names = []; group_delays = [];
    groups_line = 0;
    groups_ready = FALSE;
    groups_query = NULL_KEY;
    if (llGetInventoryType(GROUPS_CARD) != INVENTORY_NOTECARD)
    {
        say("approved_groups.cfg missing. Group preview unavailable.");
        groups_ready = TRUE;
        return;
    }
    groups_query = llGetNotecardLine(GROUPS_CARD,groups_line);
}
string selectedGroups()
{
    string result = "";
    integer i;
    for (i=0;i<llGetListLength(group_sets);++i)
    {
        if (llList2String(group_sets,i) == active_set)
        {
            string group_name = llList2String(group_names,i);
            integer delay = llList2Integer(group_delays,i);
            result += "\n" + group_name + " (" + (string)delay + "s)";
        }
    }
    if (result == "") return "(no enabled groups in set)";
    return result;
}
showMenu()
{
    closeMenu();
    menu_channel = -1000000 - (integer)llFrand(900000.0);
    menu_handle = llListen(menu_channel,"",llGetOwner(),"");
    llDialog(llGetOwner(),"Sparkles Marketing HUD " + VERSION
        + "\nVenue: " + venue + "\nSet: " + active_set,
        ["Title","Message","Venue","Use Here","Preview",
         "Post","Clear","Status","Reload","Set"],menu_channel);
}
showVenues()
{
    closeMenu();
    menu_channel = -2000000 - (integer)llFrand(900000.0);
    menu_handle = llListen(menu_channel,"",llGetOwner(),"");
    llDialog(llGetOwner(),"Choose venue",
        ["Alias","List","Manual","Use Here","Back"],menu_channel);
}
prompt(integer mode,string label)
{
    closeInput();
    input_mode = mode;
    input_channel = -3000000 - (integer)llFrand(900000.0);
    input_handle = llListen(input_channel,"",llGetOwner(),"");
    llTextBox(llGetOwner(),label,input_channel);
}
integer validateDraft()
{
    if (title == "" || message == "" || venue == "" || slurl == "")
    { say("Title, message and venue SLURL are required."); return FALSE; }
    if (llStringLength(title) > 64)
    { say("Title too long; no truncation."); return FALSE; }
    if (llSubStringIndex(slurl,"https://maps.secondlife.com/secondlife/") != 0)
    { say("Invalid Second Life map SLURL."); return FALSE; }
    string body = noticeBody();
    if (llStringLength(body) > 448
        || llStringLength(title) + 1 + llStringLength(body) > 510)
    { say("Notice exceeds text limit; no truncation."); return FALSE; }
    return TRUE;
}
preview()
{
    say("SPARKLES NOTICE PREVIEW"
        + "\nVenue: " + venue
        + "\nLandmark inventory name: " + landmark
        + "\nGroup set: " + active_set + selectedGroups()
        + "\nSubject:\n" + title
        + "\nBody:\n" + noticeBody()
        + "\n\nPreview only. Nothing sent.");
}
post()
{
    if (!validateDraft()) return;
    say("NOT SENT: native authenticated HUD-to-Sparkles object messaging "
        + "is not implemented. There is NO HTTP/Corrade fallback.");
}
status()
{
    say("Sparkles HUD v" + VERSION
        + "\nVenue: " + venue
        + "\nSet: " + active_set
        + "\nVenues loaded: " + (string)llGetListLength(aliases)
        + "\nEnabled group entries loaded: " + (string)llGetListLength(group_sets)
        + "\nNotice transport: NOT CONNECTED (native SL pending)");
}
default
{
    state_entry()
    {
        loadVenues();
        loadGroups();
        say("Sparkles Marketing HUD " + VERSION
            + " ready for preview. Native Post not connected.");
    }
    touch_start(integer count)
    {
        if (llDetectedKey(0) == llGetOwner()) showMenu();
    }
    listen(integer channel,string name,key speaker,string value)
    {
        if (speaker != llGetOwner()) return;
        if (channel == input_channel)
        {
            integer mode = input_mode;
            closeInput();
            input_mode = 0;
            if (mode == INPUT_TITLE) title = value;
            else if (mode == INPUT_MESSAGE) message = value;
            else if (mode == INPUT_ALIAS)
            {
                integer index = llListFindList(aliases,
                    [llToLower(trim(value))]);
                if (index < 0) say("Venue alias not found.");
                else
                {
                    venue = llList2String(venue_names,index);
                    slurl = llList2String(venue_urls,index);
                    landmark = llList2String(venue_landmarks,index);
                }
            }
            else if (mode == INPUT_VENUE)
            {
                venue = trim(value);
                landmark = "";
                prompt(INPUT_SLURL,"Enter venue's Second Life map SLURL:");
                return;
            }
            else if (mode == INPUT_SLURL) slurl = trim(value);
            else if (mode == INPUT_SET)
            {
                string selected = llToLower(trim(value));
                if (selected == "all" || selected == "events") active_set = selected;
                else say("Choose all or events.");
            }
            showMenu();
            return;
        }
        if (channel != menu_channel) return;
        if (value == "Title") prompt(INPUT_TITLE,"Enter exact title:");
        else if (value == "Message") prompt(INPUT_MESSAGE,"Enter exact notice body:");
        else if (value == "Venue") showVenues();
        else if (value == "Alias") prompt(INPUT_ALIAS,"Venue alias:");
        else if (value == "Manual") prompt(INPUT_VENUE,"Venue name:");
        else if (value == "List")
        {
            integer i;
            string names = "Venue aliases:";
            for(i=0;i<llGetListLength(aliases);++i)
                names += "\n" + llList2String(aliases,i);
            say(names);
            showVenues();
        }
        else if (value == "Use Here")
        {
            venue = llGetRegionName();
            slurl = hereURL();
            landmark = "";
            showMenu();
        }
        else if (value == "Preview") { preview(); showMenu(); }
        else if (value == "Post") { post(); showMenu(); }
        else if (value == "Set") prompt(INPUT_SET,"Group set: all or events");
        else if (value == "Clear")
        {
            title = ""; message = ""; venue = ""; slurl = ""; landmark = "";
            say("Draft cleared.");
            showMenu();
        }
        else if (value == "Status") { status(); showMenu(); }
        else if (value == "Reload") { loadVenues(); loadGroups(); showMenu(); }
        else if (value == "Back") showMenu();
    }
    dataserver(key query,string data)
    {
        if (query == venues_query)
        {
            if (data == EOF)
            {
                venues_ready = TRUE;
                say("Venues loaded: " + (string)llGetListLength(aliases));
                return;
            }
            string line = trim(data);
            if (line != "" && llGetSubString(line,0,0) != "#")
            {
                list f = llParseStringKeepNulls(line,["|"],[]);
                if (llGetListLength(f) >= 5
                    && (integer)trim(llList2String(f,4)) == 1)
                {
                    aliases += [llToLower(trim(llList2String(f,0)))];
                    venue_names += [trim(llList2String(f,1))];
                    venue_urls += [trim(llList2String(f,2))];
                    venue_landmarks += [trim(llList2String(f,3))];
                }
            }
            ++venues_line;
            venues_query = llGetNotecardLine(VENUES_CARD,venues_line);
            return;
        }
        if (query == groups_query)
        {
            if (data == EOF)
            {
                groups_ready = TRUE;
                say("Enabled group entries: "
                    + (string)llGetListLength(group_sets));
                return;
            }
            string group_line = trim(data);
            if (group_line != "" && llGetSubString(group_line,0,0) != "#")
            {
                list f = llParseStringKeepNulls(group_line,["|"],[]);
                if (llGetListLength(f) == 4)
                {
                    string set_name = llToLower(trim(llList2String(f,0)));
                    string group_name = trim(llList2String(f,1));
                    integer enabled = (integer)trim(llList2String(f,2));
                    integer delay = (integer)trim(llList2String(f,3));
                    if ((set_name == "all" || set_name == "events")
                        && enabled == 1 && group_name != ""
                        && delay >= 1 && delay <= 3600)
                    {
                        group_sets += [set_name];
                        group_names += [group_name];
                        group_delays += [delay];
                    }
                }
            }
            ++groups_line;
            groups_query = llGetNotecardLine(GROUPS_CARD,groups_line);
        }
    }
    changed(integer change)
    {
        if (change & CHANGED_INVENTORY)
        {
            loadVenues();
            loadGroups();
        }
    }
    on_rez(integer parameter) { llResetScript(); }
}
