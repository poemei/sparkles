// Sparkles Entertainment Marketing HUD — manual submission stage
// Powered by STN-Labz. No Corrade, PHP, Discord, or hardcoded groups.
// Configuration (owner-only inventory notecard sparkles-hud.cfg):
// endpoint|https://YOUR-AUTHORIZED-HOST/notice
// token|YOUR-INDEPENDENT-HUD-TOKEN
// The external HTTPS route must forward POST /notice to Sparkles' local
// authenticated intake. Do not put a production token in public GitHub.
// OPTIONAL venues.cfg: alias|venue|slurl|landmark hint|enabled
// This stage sends a single POST. The backend must implement op=post
// before notices can be queued. Queued does NOT mean published.

string VERSION = "1.4.1";
string CONFIG_CARD = "sparkles-hud.cfg";
string VENUES_CARD = "venues.cfg";
string GROUPS_CARD = "approved_groups.cfg";
string SIGNATURE = "~~ This message generated by Sparkles Entertainment ~~";

string endpoint = "";
string token = "";
string title = "";
string message = "";
string venue = "";
string slurl = "";
string landmark = "";
string active_set = "events";
list group_sets = [];
list group_names = [];
list group_delays = [];
list dispatch_names = [];
list dispatch_delays = [];
integer dispatch_index = 0;
integer queued_count = 0;
integer dispatching = FALSE;
integer groups_ready = FALSE;
key groups_query = NULL_KEY;
integer groups_line = 0;
list aliases = [];
list venues = [];
list urls = [];
list landmarks = [];

integer menu_channel;
integer input_channel;
integer menu_handle;
integer input_handle;
integer input_mode;
integer INPUT_TITLE = 1;
integer INPUT_MESSAGE = 2;
integer INPUT_ALIAS = 3;
integer INPUT_VENUE = 4;
integer INPUT_SLURL = 5;
integer INPUT_SET = 6;
key config_query = NULL_KEY;
integer config_line = 0;
key venue_query = NULL_KEY;
integer venue_line = 0;
key pending = NULL_KEY;
string request_id = "";
integer config_ready = FALSE;
integer venue_ready = FALSE;

say(string s) { llOwnerSay(s); }
string trimmed(string s) { return llStringTrim(s, STRING_TRIM); }

closeMenu()
{
    if (menu_handle) llListenRemove(menu_handle);
    menu_handle = 0;
}
closeInput()
{
    if (input_handle) llListenRemove(input_handle);
    input_handle = 0;
}
string hereURL()
{
    vector p = llGetPos();
    return "https://maps.secondlife.com/secondlife/"
        + llEscapeURL(llGetRegionName()) + "/"
        + (string)((integer)p.x) + "/"
        + (string)((integer)p.y) + "/"
        + (string)((integer)p.z);
}
string noticeBody()
{
    string result = message;
    if (slurl != "") result += "\n\nYour Ride Awaits -> " + slurl;
    result += "\n\n" + SIGNATURE;
    return result;
}
loadConfig()
{
    endpoint = "";
    token = "";
    config_ready = FALSE;
    config_line = 0;
    config_query = NULL_KEY;
    if (llGetInventoryType(CONFIG_CARD) != INVENTORY_NOTECARD)
    {
        say("Missing sparkles-hud.cfg. Post is disabled.");
        return;
    }
    config_query = llGetNotecardLine(CONFIG_CARD, config_line);
}
loadVenues()
{
    aliases = []; venues = []; urls = []; landmarks = [];
    venue_line = 0;
    venue_ready = FALSE;
    venue_query = NULL_KEY;
    if (llGetInventoryType(VENUES_CARD) != INVENTORY_NOTECARD)
    {
        venue_ready = TRUE;
        return;
    }
    venue_query = llGetNotecardLine(VENUES_CARD, venue_line);
}
loadGroups()
{
    group_sets = []; group_names = []; group_delays = [];
    groups_line = 0; groups_ready = FALSE;
    groups_query = NULL_KEY;
    if (llGetInventoryType(GROUPS_CARD) != INVENTORY_NOTECARD)
    {
        say("Missing approved_groups.cfg. Post disabled.");
        return;
    }
    groups_query = llGetNotecardLine(GROUPS_CARD,groups_line);
}
integer prepareGroups()
{
    dispatch_names = []; dispatch_delays = [];
    integer i;
    for (i=0;i<llGetListLength(group_sets);++i)
    {
        if (llList2String(group_sets,i) == active_set)
        {
            string n = llList2String(group_names,i);
            if (llListFindList(dispatch_names,[n]) == -1)
            {
                dispatch_names += [n];
                dispatch_delays += [llList2Integer(group_delays,i)];
            }
        }
    }
    return llGetListLength(dispatch_names);
}
showMenu()
{
    closeMenu();
    menu_channel = -1000000 - (integer)llFrand(900000.0);
    menu_handle = llListen(menu_channel, "", llGetOwner(), "");
    llDialog(llGetOwner(), "Sparkles Marketing HUD " + VERSION
        + "\nVenue: " + venue,
        ["Title","Message","Venue","Use Here","Preview","Post",
         "Clear","Status","Reload","Set"], menu_channel);
}
showVenues()
{
    closeMenu();
    menu_channel = -2000000 - (integer)llFrand(900000.0);
    menu_handle = llListen(menu_channel, "", llGetOwner(), "");
    llDialog(llGetOwner(), "Venue selection",
        ["Alias","List","Manual","Use Here","Back"], menu_channel);
}
prompt(integer mode,string label)
{
    closeInput();
    input_mode = mode;
    input_channel = -3000000 - (integer)llFrand(900000.0);
    input_handle = llListen(input_channel, "", llGetOwner(), "");
    llTextBox(llGetOwner(),label,input_channel);
}
integer ready()
{
    if (pending != NULL_KEY) { say("A submission is pending."); return FALSE; }
    if (!config_ready || endpoint == "" || token == "")
    { say("Configure HTTPS endpoint and token first."); return FALSE; }
    if (llSubStringIndex(endpoint,"https://") != 0)
    { say("Endpoint must use HTTPS."); return FALSE; }
    if (!groups_ready || !venue_ready || prepareGroups() == 0)
    { say("No enabled groups for set: " + active_set); return FALSE; }
    if (title == "" || message == "")
    { say("Title and message are required."); return FALSE; }
    if (venue == "" || slurl == "")
    { say("Choose a venue and SLURL."); return FALSE; }
    if (llStringLength(title) > 64)
    { say("Title exceeds 64 characters; not truncated."); return FALSE; }
    if (llSubStringIndex(slurl,"https://maps.secondlife.com/secondlife/") != 0)
    { say("Venue SLURL must be an official Second Life map URL."); return FALSE; }
    return TRUE;
}
submitNext()
{
    if (!dispatching || pending != NULL_KEY) return;
    string target = llList2String(dispatch_names,dispatch_index);
    request_id = "hud-" + (string)llGetUnixTime() + "-"
        + (string)((integer)llFrand(1000000000.0));
    string fields = "op=post"
        + "&request_id=" + llEscapeURL(request_id)
        + "&title=" + llEscapeURL(title)
        + "&message=" + llEscapeURL(message)
        + "&group=" + llEscapeURL(target)
        + "&landmark=" + llEscapeURL(landmark)
        + "&venue=" + llEscapeURL(venue)
        + "&location=" + llEscapeURL(slurl)
        + "&operator_uuid=" + llEscapeURL((string)llGetOwner())
        + "&object_uuid=" + llEscapeURL((string)llGetKey());
    pending = llHTTPRequest(endpoint,
        [HTTP_METHOD,"POST",
         HTTP_MIMETYPE,"application/x-www-form-urlencoded",
         HTTP_CUSTOM_HEADER,"X-Sparkles-Object-Token",
         token,HTTP_VERIFY_CERT,TRUE],fields);
    if (pending == NULL_KEY)
    {
        dispatching = FALSE;
        say("HTTP request not started. Dispatch stopped.");
    }
    else say("Queue request for " + target
        + " (" + (string)(dispatch_index+1) + "/"
        + (string)llGetListLength(dispatch_names) + ").");
}
submit()
{
    if (dispatching) { say("Dispatch already running."); return; }
    if (!ready()) return;
    dispatching = TRUE;
    dispatch_index = 0;
    queued_count = 0;
    submitNext();
}
preview()
{
    say("SPARKLES MARKETING PREVIEW\nVenue: " + venue
        + "\nLandmark inventory name: " + landmark
        + "\nMarketing set: " + active_set
        + "\nEnabled groups: " + (string)prepareGroups()
        + "\n\nTitle:\n" + title
        + "\n\nNotice:\n" + noticeBody());
}
showStatus()
{
    say("Sparkles HUD " + VERSION
        + "\nConfiguration: " + (string)config_ready
        + "\nVenues loaded: " + (string)llGetListLength(aliases)
        + "\nGroups loaded: " + (string)llGetListLength(group_sets)
        + "\nSet: " + active_set
        + "\nDispatching: " + (string)dispatching
        + "\nQueued attempts: " + (string)queued_count
        + "\nVenue: " + venue
        + "\nTitle set: " + (string)(title != "")
        + "\nMessage set: " + (string)(message != "")
        + "\nPending request: " + (string)(pending != NULL_KEY)
        + "\nLast request: " + request_id);
}
default
{
    state_entry()
    {
        loadConfig();
        loadVenues();
        loadGroups();
        say("Sparkles Marketing HUD " + VERSION + " ready (manual Post).");
    }
    touch_start(integer count)
    {
        if (llDetectedKey(0) == llGetOwner()) showMenu();
    }
    listen(integer channel,string name,key speaker,string value)
    {
        if (speaker != llGetOwner()) return;
        if (channel == input_channel)
        {
            integer mode = input_mode;
            closeInput(); input_mode = 0;
            if (mode == INPUT_TITLE) title = value;
            else if (mode == INPUT_MESSAGE) message = value;
            else if (mode == INPUT_ALIAS)
            {
                integer ix = llListFindList(aliases,[llToLower(trimmed(value))]);
                if (ix < 0) say("Unknown venue alias.");
                else
                {
                    venue = llList2String(venues,ix);
                    slurl = llList2String(urls,ix);
                    landmark = llList2String(landmarks,ix);
                }
            }
            else if (mode == INPUT_VENUE)
            {
                venue = trimmed(value);
                landmark = "";
                prompt(INPUT_SLURL,"Paste the map SLURL for " + venue);
                return;
            }
            else if (mode == INPUT_SLURL) slurl = trimmed(value);
            else if (mode == INPUT_SET)
            {
                string candidate = llToLower(trimmed(value));
                if (candidate == "all" || candidate == "events") active_set = candidate;
                else say("Choose all or events.");
            }
            showMenu(); return;
        }
        if (channel != menu_channel) return;
        if (value == "Title") prompt(INPUT_TITLE,"Enter exact notice title:");
        else if (value == "Message") prompt(INPUT_MESSAGE,"Enter exact notice body:");
        else if (value == "Venue") showVenues();
        else if (value == "Alias") prompt(INPUT_ALIAS,"Enter venue alias:");
        else if (value == "Manual") prompt(INPUT_VENUE,"Enter venue name:");
        else if (value == "List")
        {
            integer i;
            string listing = "Venues:";
            for (i=0;i<llGetListLength(aliases);++i)
                listing += "\n" + llList2String(aliases,i);
            say(listing); showVenues();
        }
        else if (value == "Use Here")
        {
            venue = llGetRegionName(); slurl = hereURL(); landmark = ""; showMenu();
        }
        else if (value == "Preview") { preview(); showMenu(); }
        else if (value == "Post") { submit(); showMenu(); }
        else if (value == "Set") prompt(INPUT_SET,"Marketing set: all or events");
        else if (value == "Status") { showStatus(); showMenu(); }
        else if (value == "Clear")
        {
            if (dispatching || pending != NULL_KEY) say("Dispatch active; cannot clear.");
            else { title = ""; message = ""; venue = ""; slurl = ""; landmark = ""; }
            showMenu();
        }
        else if (value == "Reload")
        {
            if (!dispatching && pending == NULL_KEY) { loadConfig(); loadVenues(); loadGroups(); }
            showMenu();
        }
        else if (value == "Back") showMenu();
    }
    dataserver(key q,string data)
    {
        if (q == config_query)
        {
            if (data == EOF)
            {
                config_ready = (endpoint != "" && token != "");
                if (!config_ready) say("HUD configuration incomplete.");
                return;
            }
            string line = trimmed(data);
            if (line != "" && llGetSubString(line,0,0) != "#")
            {
                list parts = llParseStringKeepNulls(line,["|"],[]);
                if (llGetListLength(parts) == 2)
                {
                    string k = trimmed(llList2String(parts,0));
                    string v = trimmed(llList2String(parts,1));
                    if (k == "endpoint") endpoint = v;
                    else if (k == "token") token = v;
                }
            }
            ++config_line;
            config_query = llGetNotecardLine(CONFIG_CARD,config_line);
            return;
        }
        if (q == venue_query)
        {
            if (data == EOF) { venue_ready = TRUE; return; }
            string line2 = trimmed(data);
            if (line2 != "" && llGetSubString(line2,0,0) != "#")
            {
                list fields = llParseStringKeepNulls(line2,["|"],[]);
                if (llGetListLength(fields) >= 5 &&
                    (integer)llList2String(fields,4) == 1)
                {
                    aliases += [llToLower(trimmed(llList2String(fields,0)))];
                    venues += [trimmed(llList2String(fields,1))];
                    urls += [trimmed(llList2String(fields,2))];
                    landmarks += [trimmed(llList2String(fields,3))];
                }
            }
            ++venue_line;
            venue_query = llGetNotecardLine(VENUES_CARD,venue_line);
        }
        if (q == groups_query)
        {
            if (data == EOF)
            {
                groups_ready = TRUE;
                say("Approved marketing groups loaded: " + (string)llGetListLength(group_sets));
                return;
            }
            string groupLine = trimmed(data);
            if (groupLine != "" && llGetSubString(groupLine,0,0) != "#")
            {
                list f = llParseStringKeepNulls(groupLine,["|"],[]);
                if (llGetListLength(f) == 4)
                {
                    string setName = llToLower(trimmed(llList2String(f,0)));
                    string groupName = trimmed(llList2String(f,1));
                    integer enabled = (integer)trimmed(llList2String(f,2));
                    integer delay = (integer)trimmed(llList2String(f,3));
                    if (enabled == 1 && (setName == "all" || setName == "events")
                        && groupName != "" && delay >= 1 && delay <= 3600)
                    {
                        group_sets += [setName];
                        group_names += [groupName];
                        group_delays += [delay];
                    }
                }
            }
            ++groups_line;
            groups_query = llGetNotecardLine(GROUPS_CARD,groups_line);
        }
    }
    http_response(key req,integer status,list metadata,string body)
    {
        if (req != pending) return;
        pending = NULL_KEY;
        if (status == 200 && llSubStringIndex(body,"\"status\":\"queued\"") != -1)
        {
            ++queued_count;
            ++dispatch_index;
            say("Queued at Sparkles: "
                + llList2String(dispatch_names,dispatch_index-1)
                + ". Publication NOT confirmed.");
            if (dispatch_index >= llGetListLength(dispatch_names))
            {
                dispatching = FALSE;
                llSetTimerEvent(0.0);
                say("All " + (string)queued_count
                    + " queue attempts accepted; publication unverified.");
            }
            else llSetTimerEvent((float)llList2Integer(dispatch_delays,dispatch_index-1));
        }
        else
        {
            dispatching = FALSE;
            llSetTimerEvent(0.0);
            say("Dispatch stopped at " + llList2String(dispatch_names,dispatch_index)
                + ": HTTP " + (string)status + " " + body);
        }
    }
    timer()
    {
        llSetTimerEvent(0.0);
        submitNext();
    }
    changed(integer flags)
    {
        if (flags & CHANGED_INVENTORY)
        {
            if (!dispatching && pending == NULL_KEY) { loadConfig(); loadVenues(); loadGroups(); }
        }
    }
    on_rez(integer p) { llResetScript(); }
}
